{{!< default}}

<header class="archive-header wrap">
    <span class="archive-kicker">Author</span>
    <h1 class="archive-title">{{name}}</h1>
    {{#if bio}}
        <p class="archive-description">{{bio}}</p>
    {{/if}}
</header>

<section class="post-feed wrap">
    {{#foreach posts}}
        {{> post-card}}
    {{/foreach}}
</section>

{{pagination}}
