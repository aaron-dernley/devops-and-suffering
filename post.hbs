{{!< default}}

<article class="post wrap {{post_class}}">
    <header class="post-header">
        {{#if primary_tag}}
            <a class="post-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
        {{/if}}
        <h1 class="post-title">{{title}}</h1>
        <div class="post-meta">
            {{#if primary_author}}
                <span class="post-meta-author">{{primary_author.name}}</span>
            {{/if}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
            <span class="post-meta-reading-time">{{reading_time}}</span>
        </div>
    </header>

    {{#if feature_image}}
        <div class="post-feature-image">
            <img src="{{feature_image}}" alt="{{title}}">
        </div>
    {{/if}}

    <div class="post-content">
        {{content}}
    </div>

    {{#if tags}}
        <footer class="post-tags">
            {{#foreach tags}}
                <a href="{{url}}">{{name}}</a>
            {{/foreach}}
        </footer>
    {{/if}}
</article>
