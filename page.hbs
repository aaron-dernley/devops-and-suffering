{{!< default}}

<article class="post wrap page {{post_class}}">
    <header class="post-header">
        <h1 class="post-title">{{title}}</h1>
    </header>

    {{#if feature_image}}
        <div class="post-feature-image">
            <img src="{{feature_image}}" alt="{{title}}">
        </div>
    {{/if}}

    <div class="post-content">
        {{content}}
    </div>
</article>
